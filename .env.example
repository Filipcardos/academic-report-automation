# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── SQL Server ─────────────────────────────────────────────────────────────────
DB_SERVER=localhost        # ou nome do container: sqlserver
DB_NAME=AcademicDB
DB_USER=sa
SA_PASSWORD=Afya@2024      # mínimo 8 chars, maiúsc + núm + especial

# ── App ────────────────────────────────────────────────────────────────────────
USE_SEED=false             # true = dados sintéticos (sem SQL Server)
OUTPUT_DIR=reports         # pasta local de saída dos relatórios
